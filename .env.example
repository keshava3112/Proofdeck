# Optional: Claude writes the deck. Without it, the offline template generator is used.
ANTHROPIC_API_KEY=
PROOFDECK_MODEL=claude-sonnet-5-5

# Dashboard access: /admin?key=...
PROOFDECK_ADMIN_KEY=change-me
# Base URL printed in share links (your domain)
PROOFDECK_BASE_URL=http://localhost:8000

# Alerts: a Slack incoming webhook. Without it, alerts print to the console.
SLACK_WEBHOOK_URL=

DATABASE_URL=sqlite:///proofdeck.db
